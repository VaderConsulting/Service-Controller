<?xml version="1.0"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="ServiceController.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="ServiceController.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <system.diagnostics>
        <sources>
            <!-- This section defines the logging configuration for My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                    <!-- Uncomment the below section to write to the Application Event Log -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information"/>
        </switches>
        <sharedListeners>
            <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter"/>
            <!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
<startup><supportedRuntime version="v2.0.50727"/></startup>
    <userSettings>
        <ServiceController.My.MySettings>
            <setting name="StartStopTime1LastDate" serializeAs="String">
                <value>1900-01-01</value>
            </setting>
            <setting name="StartStopTime2LastDate" serializeAs="String">
                <value>1900-01-01</value>
            </setting>
            <setting name="StartStopTime3LastDate" serializeAs="String">
                <value>1900-01-01</value>
            </setting>
            <setting name="StartStopTime4LastDate" serializeAs="String">
                <value>1900-01-01</value>
            </setting>
        </ServiceController.My.MySettings>
    </userSettings>
    <applicationSettings>
        <ServiceController.My.MySettings>
            <setting name="ServiceName" serializeAs="String">
                <value>Fax</value>
            </setting>
            <setting name="StartStopTime1" serializeAs="String">
                <value>19:00</value>
            </setting>
            <setting name="StartStopTime2" serializeAs="String">
                <value>19:30</value>
            </setting>
            <setting name="StartStopTime3" serializeAs="String">
                <value>20:00</value>
            </setting>
            <setting name="StartStopTime4" serializeAs="String">
                <value>20:30</value>
            </setting>
            <setting name="StopTimeSeconds" serializeAs="String">
                <value>20</value>
            </setting>
        </ServiceController.My.MySettings>
    </applicationSettings>
</configuration>
